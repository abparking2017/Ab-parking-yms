        const rows = ["Front LH","Front RH","Rear In RH","Rear Out RH","Rear In LH","Rear Out LH","Middle RH","Middle LH","Inn Mid RH","Inn Mid LH","Hydr RH","Hydr LH","Spare Tyre"];
        let tyres = rows.map((p,i)=>`<div class="tyre-row-complex"><span class="col-1-pos">${p}</span><div class="col-2-stat yn-group"><label><input type="radio" name="t${i}_${s}" value="avl" onclick="syncRadio(this)">Avl</label><label><input type="radio" name="t${i}_${s}" value="na" onclick="syncRadio(this)">NA</label></div><div class="col-3-make"><input type="text" class="tyre-make-input sync-tm-${i}" oninput="syncValue(this)" list="tyre_brands"></div><div class="col-4-cond"><select class="tyre-cond-select" data-sync-id="tc_${i}" onchange="syncSelect(this)"><option value="">Cond...</option><option>Good</option><option>Avg</option><option>Bad</option><option>Damage</option><option>Plane</option></select></div></div>`).join('');

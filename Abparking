<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>A.B. PARKING YMS v26</title>
    <style>
        /* --- GLOBAL THEME --- */
        :root { --primary: #000080; --bg: #f4f7f6; --text: #000; --success: #28a745; --danger: #dc3545; --warning: #ff9800; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; background: var(--bg); color: var(--text); -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; overflow-x: hidden; }

        /* --- LOGIN SCREEN (ALWAYS VISIBLE FIRST) --- */
        #login-view { 
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; 
            background: linear-gradient(135deg, #0f2027, #2c5364); 
            display: flex; flex-direction: column; justify-content: center; align-items: center; 
            z-index: 9999; color: white;
        }
        .login-box { 
            background: rgba(255,255,255,0.95); padding: 40px; border-radius: 15px; 
            text-align: center; width: 85%; max-width: 300px; color: #333;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .login-input { padding: 12px; font-size: 16px; border-radius: 5px; border: 1px solid #ccc; margin-bottom: 15px; width: 100%; box-sizing: border-box; text-align: center; }
        .login-btn { padding: 12px 30px; background: var(--primary); color: white; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; width: 100%; }
        .forgot-link { color: #ccc; font-size: 12px; text-decoration: underline; margin-top: 15px; cursor: pointer; display: block; }

        /* --- DASHBOARD --- */
        #dashboard-view { padding: 15px; padding-bottom: 90px; background: #fff; min-height: 100vh; width: 100vw; box-sizing: border-box; display: none; }
        
        .app-header { 
            background: var(--primary); color: white; padding: 20px; 
            border-radius: 15px; margin-bottom: 20px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.2); 
            display: flex; justify-content: space-between; align-items: center;
        }
        .header-left h1 { margin: 0; font-family: 'Impact', sans-serif; letter-spacing: 1px; font-weight: normal; font-size: 22px; }
        .header-left p { margin: 5px 0 0; opacity: 0.8; font-size: 11px; font-family: monospace; }
        .btn-logout { background: var(--danger); color: white; border: none; padding: 5px 10px; border-radius: 5px; font-size: 10px; cursor: pointer; font-weight: bold; }
        .btn-new-entry { background: white; color: var(--primary); border: none; padding: 10px 15px; border-radius: 8px; font-weight: 900; font-size: 12px; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.2); text-transform: uppercase; margin-top: 10px; width: 100%; }

        /* CONTROLS */
        .controls-row { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; }
        .search-bar { flex-grow: 1; padding: 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; background: #f9f9f9; }
        .btn-dash { border: none; border-radius: 8px; padding: 10px 15px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; color: white; font-size: 12px; flex: 1; min-width: 80px; }
        .btn-excel { background: var(--success); }
        .btn-stock { background: #ffc107; color: black; }
        .btn-hr { background: #ff5722; }
        .admin-only { display: none; }

        /* REPORT CARD */
        .report-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 15px; }
        .report-card { background: #222; color: white; padding: 15px; border-radius: 10px; text-align: center; }
        .rc-val { font-size: 20px; font-weight: bold; color: #ffeb3b; display: block; }
        .rc-lbl { font-size: 10px; opacity: 0.7; text-transform: uppercase; }

        .vehicle-card { background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border-left: 5px solid var(--primary); display: flex; justify-content: space-between; align-items: center; position: relative; border: 1px solid #eee; }
        .vehicle-card.released { border-left-color: var(--danger); opacity: 0.7; }
        .vc-info h3 { margin: 0 0 5px; color: var(--primary); font-size: 16px; }
        .vc-info p { margin: 0; font-size: 12px; color: #666; }
        .vc-status-badge { position: absolute; top: 10px; right: 10px; font-size: 10px; background: #eee; padding: 2px 6px; border-radius: 4px; font-weight: bold; }
        .released .vc-status-badge { background: var(--danger); color: white; }
        .vc-actions { display: flex; flex-direction: column; gap: 5px; min-width: 70px; }
        .btn-mini { padding: 6px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; border: none; color: white; cursor: pointer; }
        .btn-edit { background: #555; } .btn-bill { background: var(--success); } .btn-exit { background: var(--danger); }
        .btn-del { background: #000; }

        .fab { position: fixed; bottom: 25px; right: 25px; background: var(--primary); color: white; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 30px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); cursor: pointer; z-index: 1000; }

        /* --- VIEW CONTAINERS --- */
        #editor-view, #invoice-view, #gatepass-view, #stock-view, #hr-view, #salary-view { display: none; background: #fff; min-height: 100vh; padding-bottom: 50px; width: 100%; position: absolute; top:0; left:0; }
        
        .toolbar { background: #222; color: white; padding: 10px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 2000; box-shadow: 0 2px 5px rgba(0,0,0,0.5); width: 100%; box-sizing: border-box; }
        .btn-tool { background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: white; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
        .btn-primary { background: var(--primary); border: none; }

        .zoom-controls { position: sticky; top: 50px; left: 0; right: 0; background: rgba(0,0,0,0.8); color: white; padding: 5px 15px; z-index: 1900; display: flex; align-items: center; justify-content: space-between; font-size: 12px; }
        .zoom-slider { width: 150px; }

        .paper-scroll { width: 100%; overflow: auto; padding: 10px 0; box-sizing: border-box; transform-origin: top left; }

        /* --- PAPER FORMAT --- */
        .page-container { width: 210mm; min-width: 210mm; height: 290mm; background: white; margin: 0 auto 20px auto; padding: 15px 25px; box-sizing: border-box; position: relative; border: 1px solid #000; overflow: hidden; margin-left: 0; }
        .bill-container { width: 210mm; min-width: 210mm; min-height: 148mm; background: white; margin: 0 0 20px 0; padding: 30px 40px; box-sizing: border-box; border: 1px solid #000; position: relative; }
        .invoice-page { width: 210mm; min-width: 210mm; height: 290mm; background: white; margin: 0 0 20px 0; box-sizing: border-box; position: relative; border: 1px solid #000; overflow: hidden; padding: 10px; display: flex; flex-direction: column; justify-content: space-between; }
        .half-bill { height: 48%; border: 2px solid #000; padding: 20px; box-sizing: border-box; position: relative; }
        .cut-line { border-top: 2px dashed #000; position: relative; top: -5px; }

        /* --- PRINT CSS --- */
        @page { size: A4; margin: 0; }
        @media print {
            body { background: white; margin: 0; padding: 0; overflow: hidden; height: 100%; transform: scale(1) !important; zoom: 1 !important; }
            #login-view, #dashboard-view, #stock-view, #hr-view, .toolbar, .zoom-controls { display: none !important; }
            .paper-scroll { overflow: visible; padding: 0; display: block; width: 100%; height: 100%; transform: none !important; }
            
            /* FORCE VISIBILITY FOR PRINTING */
            body.print-inventory #editor-view { display: block !important; visibility: visible; }
            body.print-inventory #invoice-view, body.print-inventory #gatepass-view, body.print-inventory #salary-view { display: none !important; }
            
            body.print-invoice #invoice-view { display: block !important; visibility: visible; }
            body.print-invoice #editor-view, body.print-invoice #gatepass-view, body.print-invoice #salary-view { display: none !important; }
            
            body.print-pass #gatepass-view { display: block !important; visibility: visible; }
            body.print-pass #editor-view, body.print-pass #invoice-view, body.print-pass #salary-view { display: none !important; }

            body.print-salary #salary-view { display: block !important; visibility: visible; }
            body.print-salary #editor-view, body.print-salary #invoice-view, body.print-salary #gatepass-view { display: none !important; }

            .page-container, .invoice-page { margin: 0; border: none; width: 100%; height: 290mm; page-break-after: always; overflow: hidden; margin-left: 0; }
            .page-container:last-child, .invoice-page:last-child { page-break-after: auto; }
            .bill-container { margin: 0; border: none; width: 100%; min-height: auto; page-break-after: avoid; }
            
            input[type="text"], input[type="number"] { border-bottom: 1px dotted #000 !important; border-top:none; border-left:none; border-right:none; background:transparent; }
            .watermark { opacity: 0.15 !important; color: #000 !important; }
        }

        /* --- FORM ELEMENTS --- */
        
        .watermark { 
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); 
            width: 700px; pointer-events: none; z-index: 0; opacity: 0.15;
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            color: #000; font-weight: 900; 
            /* Digital Style Border */
            border: 4px dashed #000;
            outline: 2px solid #000;
            outline-offset: 10px;
            padding: 30px;
            border-radius: 10px;
        }
        .watermark-text { 
            font-family: 'Arial Black', Impact, sans-serif; font-size: 55px; 
            white-space: nowrap; line-height: 1; margin-top: 15px;
            text-transform: uppercase; letter-spacing: 2px;
        }
        .watermark svg { width: 350px; fill: #000; margin-bottom: -10px; }
        
        .copy-label { position: absolute; top: 15px; right: 15px; z-index: 5; }
        .copy-text { font-size: 12px; font-weight: 900; border: 2px solid #000; padding: 4px 10px; background: #fff; box-shadow: 3px 3px 0 #000; }

        /* SL NO (FIXED LEFT) */
        .sl-no-container { position: absolute; top: 30px; left: 30px; z-index: 5; display: flex; flex-direction: column; align-items: flex-start; }
        .sl-no-text { font-size: 11px; font-weight: 900; color: #000; margin-bottom: 2px; text-decoration: underline; }
        .sl-input { width: 60px; font-weight: 900; color: #d9534f; font-size: 13px; border: none; border-bottom: 2px solid #000; background: transparent; font-family: 'Courier New', monospace; text-align: left; height: 16px; }
        
        .qr-box { position: absolute; top: 55px; right: 25px; z-index: 5; }
        .qr-img { width: 75px; height: 75px; border: 1px solid #000; padding: 2px; background: white; display: block; }

        /* HEADER */
        .header { text-align: center; border-bottom: 4px solid #000; margin-bottom: 10px; padding-bottom: 8px; margin-top: 5px; position: relative; z-index: 1; }
        .header h1 { color: #000; font-family: 'Arial Black', 'Impact', sans-serif; font-size: 44px; margin: 0; letter-spacing: 2px; text-transform: uppercase; text-shadow: 3px 3px 0px #ccc; line-height: 1; }
        .sub-header { font-size: 16px; font-weight: 900; letter-spacing: 5px; background: #000; color: #fff; display: inline-block; padding: 5px 30px; margin: 8px 0; font-family: 'Courier New', monospace; border-radius: 0; clip-path: polygon(10px 0, 100% 0, 100% 100%, 0% 100%); }
        .address { font-size: 11px; color: #000; line-height: 1.4; font-weight: bold; font-family: 'Segoe UI', sans-serif; text-transform: uppercase; letter-spacing: 0.5px; }

        .main-row { display: flex; gap: 15px; position: relative; z-index: 1; }
        .col-left { width: 50%; } .col-right { width: 50%; }
        .field-row { display: flex; align-items: center; margin-bottom: 2px; font-size: 11px; font-weight: bold; }
        .label { width: 140px; flex-shrink: 0; }
        
        input[type="text"] { border: none; border-bottom: 1px dotted #999; background: transparent; font-family: 'Courier New', monospace; font-size: 11px; font-weight: bold; color: #000; flex-grow: 1; height: 16px; outline: none; width: 100%; }
        
        .yn-group { display: flex; gap: 5px; align-items: center; height: 16px; margin-right: 5px; }
        .yn-group label { cursor: pointer; display: flex; align-items: center; gap:2px; white-space: nowrap; font-size: 10px; }
        .yn-group input[type="radio"] { appearance: none; width: 12px; height: 12px; border: 1px solid #000; border-radius: 2px; background: #fff; margin: 0; display: flex; justify-content: center; align-items: center; }
        .yn-group input[type="radio"]:checked::after { content: '✔'; font-size: 12px; color: #000; font-weight: bold; line-height: 1; }
        .yn-group input[value="no"]:checked::after, .yn-group input[value="na"]:checked::after, .yn-group input[value="n"]:checked::after { content: '✖'; font-size: 10px; }

        .section-title { text-decoration: underline; font-weight: 900; margin-top: 6px; margin-bottom: 4px; display: block; font-size: 11px; }

        .tyre-header { display: flex; font-weight: 900; font-size: 10px; border-bottom: 1px solid #000; padding-bottom: 2px; margin-top: 5px; }
        .tyre-row-complex { display: flex; align-items: center; height: 18px; border-bottom: 1px solid #ccc; }
        .col-1-pos { width: 75px; flex-shrink: 0; font-weight: bold; font-size: 10px; } 
        .col-2-stat { width: 65px; flex-shrink: 0; } 
        .col-3-make { width: 110px; flex-shrink: 0; text-align: center; margin: 0 auto; }
        .col-4-cond { width: 60px; flex-shrink: 0; text-align: right; }
        .tyre-make-input { width: 105px !important; text-align: center; border-bottom: none !important; } 
        .tyre-cond-select { width: 60px; font-size: 9px; font-weight: bold; border: none; background: transparent; }

        .extra-items-grid { display: flex; gap: 10px; margin-top: 5px; } .extra-col { width: 50%; }
        .extra-item-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; border-bottom: 1px solid #ccc; height: 18px; }
        .item-name { font-size: 10px; font-weight: bold; width: 60px; flex-shrink: 0; }
        .qty-input { width: 25px !important; text-align: center; }

        .disclaimer { margin-top: 8px; border: 1px solid #000; padding: 4px; font-size: 10px; text-align: justify; }
        .warning { text-align: center; font-weight: 900; margin-top: 1px; font-size: 11px; }
        .signatures { margin-top: 15px; display: flex; justify-content: space-between; font-size: 11px; font-weight: bold; }
        .sig-box { width: 32%; border-top: 1px solid #000; padding-top: 5px; line-height: 1.4; }

        .bill-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
        .bill-table th, .bill-table td { border: 1px solid #000; padding: 5px; text-align: center; }
        .bill-input { width: 60px; border: none; border-bottom: 1px dotted #999; text-align: center; font-family: monospace; font-weight: bold; font-size: 12px; }
        .bill-total { text-align: right; font-size: 16px; font-weight: 900; padding-top: 10px; border-top: 2px solid #000; margin-top: 5px; }
        
        .pass-content { border: 2px dashed #000; padding: 20px; margin-top: 20px; }
        .release-input { font-size: 14px; font-weight: bold; border: none; border-bottom: 2px solid #000; width: 200px; outline: none; background: transparent; }
        
        .stock-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .stock-card { background: white; padding: 15px; border-radius: 10px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .stock-num { font-size: 24px; font-weight: 900; color: var(--primary); display: block; }
        .stock-lbl { font-size: 10px; color: #666; text-transform: uppercase; }
        
        .designer-credit { text-align: center; font-size: 10px; color: #aaa; margin-top: 20px; font-weight: bold; font-family: monospace; }
        
        /* HR */
        .hr-card { background: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid #ddd; margin-bottom: 10px; }
        .hr-input { width: 100%; padding: 8px; margin-bottom: 5px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .emp-list-item { display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid #eee; }
    </style>
</head>
<body>

    <div id="login-view">
        <div class="login-box">
            <h2 style="margin-top:0;">A.B. PARKING</h2>
            <p style="margin-bottom:20px;">Yard Management System</p>
            <input type="tel" id="loginUser" class="login-input" placeholder="Mobile Number">
            <input type="password" id="loginPass" class="login-input" placeholder="Password">
            <button class="login-btn" onclick="attemptLogin()">LOGIN</button>
            <span class="forgot-link" onclick="forgotPassword()">Forgot Password?</span>
        </div>
    </div>

    <div id="dashboard-view">
        <div class="app-header">
            <div class="header-left">
                <h1>A.B. PARKING YMS</h1>
                <p>Yard Management System v25.0</p>
                <span class="user-badge" id="user-role-badge">USER</span>
            </div>
            <button class="btn-logout" onclick="doLogout()">LOGOUT</button>
        </div>

        <div class="report-grid">
            <div class="report-card"><span class="rc-val" id="today-entries">0</span><span class="rc-lbl">Today's Entries</span></div>
            <div class="report-card"><span class="rc-val" id="today-exits" style="color:#ff5722;">0</span><span class="rc-lbl">Today's Exits</span></div>
            <div class="report-card"><span class="rc-val" id="today-cash" style="color:var(--success);">₹0</span><span class="rc-lbl">Today's Cash</span></div>
        </div>
        
        <button class="btn-new-entry" onclick="openEditor(true)">+ NEW ENTRY</button>

        <div class="controls-row" style="margin-top:15px;">
            <input type="text" id="searchBox" class="search-bar" placeholder="🔍 Search Regn / Name..." onkeyup="filterVehicles()">
            <button class="btn-dash btn-excel admin-only" onclick="downloadExcel()">📊 Excel</button>
            <button class="btn-dash btn-stock" onclick="showStockView()">📈 Stock</button>
            <button class="btn-dash btn-hr" onclick="showHRView()">👥 HR</button>
        </div>
        <div id="vehicle-list"></div>
        <div class="designer-credit">Designed by AJ GOLDER</div>
    </div>

    <div id="stock-view">
        <div class="app-header"><div class="header-left"><h1>STOCK REPORT</h1></div></div>
        <button class="btn-tool" style="background:#444; color:white; margin-bottom:15px;" onclick="showDashboard()">← Back</button>
        <div class="stock-grid">
            <div class="stock-card"><span class="stock-num" id="total-count">0</span><span class="stock-lbl">Total Logged</span></div>
            <div class="stock-card"><span class="stock-num" style="color:var(--danger)" id="exit-count">0</span><span class="stock-lbl">Released</span></div>
            <div class="stock-card"><span class="stock-num" style="color:var(--success)" id="yard-count">0</span><span class="stock-lbl">In Yard</span></div>
        </div>
    </div>

    <div id="hr-view">
        <div class="app-header"><div class="header-left"><h1>HR & STAFF</h1></div></div>
        <button class="btn-tool" style="background:#444; color:white; margin-bottom:15px;" onclick="showDashboard()">← Back</button>
        
        <div class="hr-card admin-only">
            <h3>Add Employee</h3>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:5px;">
                <input type="tel" id="emp-mobile" class="hr-input" placeholder="Mobile (User)">
                <input type="text" id="emp-pass" class="hr-input" placeholder="Password">
                <input type="text" id="emp-name" class="hr-input" placeholder="Name">
                <input type="number" id="emp-sal" class="hr-input" placeholder="Salary">
            </div>
            <button class="btn-mini" style="background:var(--primary); width:100%; margin-top:5px;" onclick="addEmployee()">CREATE USER</button>
        </div>

        <div class="hr-card">
            <h3>Attendance (GPS)</h3>
            <button class="btn-new-entry" style="background:var(--success); color:white; margin-top:0;" onclick="markAttendance()">📍 Check In</button>
            <div id="att-msg" style="font-size:11px; margin-top:5px; color:green;"></div>
        </div>

        <div class="hr-card">
            <h3>Employee List</h3>
            <div id="emp-list"></div>
        </div>
    </div>

    <div id="editor-view">
        <div class="toolbar">
            <button class="btn-tool" onclick="showDashboard()">← Back</button>
            <span>INVENTORY</span>
            <div>
                <button class="btn-tool btn-primary" onclick="saveData()">Save</button>
                <button class="btn-tool" onclick="printMode('inventory')">Print</button>
            </div>
        </div>
        <div class="zoom-controls"><span>Zoom:</span><input type="range" class="zoom-slider" min="0.3" max="1.2" step="0.1" value="0.4" oninput="changeZoom(this.value)"></div>
        <div class="paper-scroll"><div id="forms-container" style="transform-origin:top left; transform: scale(0.4);"></div></div>
    </div>

    <div id="invoice-view">
        <div class="toolbar">
            <button class="btn-tool" onclick="showDashboard()">← Back</button>
            <span>GST INVOICE</span>
            <button class="btn-tool btn-primary" onclick="printMode('invoice')">Print Bill</button>
        </div>
        <div class="paper-scroll"><div class="invoice-page" id="bill-content" style="transform-origin:top left; transform: scale(0.4);"></div></div>
    </div>

    <div id="gatepass-view">
        <div class="toolbar">
            <button class="btn-tool" onclick="showDashboard()">← Back</button>
            <span>GATE PASS</span>
            <div>
                <button class="btn-tool" style="background:var(--success)" onclick="markAsReleased()">✔ Release</button>
                <button class="btn-tool btn-primary" onclick="printMode('pass')">Print</button>
            </div>
        </div>
        <div class="paper-scroll"><div class="bill-container" id="pass-content" style="transform-origin:top left; transform: scale(0.4);"></div></div>
    </div>

    <div id="salary-view">
        <div class="toolbar">
            <button class="btn-tool" onclick="showHRView()">← Back</button>
            <span>SALARY SLIP</span>
            <button class="btn-tool btn-primary" onclick="printMode('salary')">Print</button>
        </div>
        <div class="paper-scroll"><div class="bill-container" id="salary-content" style="transform-origin:top left; transform: scale(0.4);"></div></div>
    </div>

<script>
    let defaultUsers = [
        { u: '8371002727', p: '1234', n: 'Administrator', r: 'admin' },
        { u: '9332443461', p: '0000', n: 'Staff', r: 'user' }
    ];
    let users = JSON.parse(localStorage.getItem('ab_users')) || defaultUsers;
    let currentUser = null;

    let vehicles = JSON.parse(localStorage.getItem('ab_vehicles')) || [];
    let employees = JSON.parse(localStorage.getItem('ab_employees')) || [];
    let currentIndex = -1;
    let currentView = localStorage.getItem('ab_current_view') || 'dashboard';

    const vehicleDatabase = {
